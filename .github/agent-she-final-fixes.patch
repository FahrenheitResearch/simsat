+/// Solid-angle-preserving block reduction used only by the offline Cox-Munk
+/// environment convolution. The direct log-SH3 radiance/irradiance fits retain the
+/// full sky-view sampling; the water prefilter sees a smooth integrand and does not
+/// need every source texel. `stride = 1` is exactly [`upper_sky_samples`].
+fn coarse_upper_sky_samples(
+    lut: &Lut2,
+    r_obs: f64,
+    stride: usize,
+) -> Vec<SkyDirectionalSample> {
+    let stride = stride.max(1);
+    if stride == 1 {
+        return upper_sky_samples(lut, r_obs);
+    }
+
+    let (width, height) = (lut.width, lut.height);
+    let d_azimuth = 2.0 * PI / width.max(1) as f64;
+    let blocks_x = width.saturating_add(stride - 1) / stride;
+    let blocks_y = height.saturating_add(stride - 1) / stride;
+    let mut samples = Vec::with_capacity(blocks_x * blocks_y / 2);
+
+    for y0 in (0..height).step_by(stride) {
+        for x0 in (0..width).step_by(stride) {
+            let mut total_solid_angle = 0.0;
+            let mut direction_sum = [0.0; 3];
+            let mut radiance_sum = [0.0; 3];
+
+            for y in y0..(y0 + stride).min(height) {
+                let v0 = y as f64 / height.max(1) as f64;
+                let v1 = (y as f64 + 1.0) / height.max(1) as f64;
+                let z0 = skyview_v_to_zenith(v0, r_obs);
+                let z1 = skyview_v_to_zenith(v1, r_obs);
+                let zenith = 0.5 * (z0 + z1);
+                if zenith >= PI / 2.0 {
+                    continue;
+                }
+                let d_zenith = (z1 - z0).abs();
+                let (sin_zenith, cos_zenith) = zenith.sin_cos();
+                let solid_angle = sin_zenith * d_zenith * d_azimuth;
+                if solid_angle <= 0.0 {
+                    continue;
+                }
+
+                for x in x0..(x0 + stride).min(width) {
+                    let azimuth = (x as f64 + 0.5) / width.max(1) as f64 * 2.0 * PI;
+                    let direction = [
+                        sin_zenith * azimuth.cos(),
+                        sin_zenith * azimuth.sin(),
+                        cos_zenith,
+                    ];
+                    let radiance = lut.fetch(x, y).map(|value| {
+                        if value.is_finite() {
+                            value.max(0.0)
+                        } else {
+                            0.0
+                        }
+                    });
+                    total_solid_angle += solid_angle;
+                    for ((direction_out, radiance_out), (direction_value, radiance_value)) in
+                        direction_sum
+                            .iter_mut()
+                            .zip(radiance_sum.iter_mut())
+                            .zip(direction.into_iter().zip(radiance))
+                    {
+                        *direction_out += direction_value * solid_angle;
+                        *radiance_out += radiance_value * solid_angle;
+                    }
+                }
+            }
+
+            if total_solid_angle <= 0.0 {
+                continue;
+            }
+            let direction = norm3(direction_sum);
+            let radiance = radiance_sum.map(|value| value / total_solid_angle);
+            samples.push(SkyDirectionalSample {
+                direction,
+                radiance,
+                solid_angle: total_solid_angle,
+            });
+        }
+    }
+    samples
+}
